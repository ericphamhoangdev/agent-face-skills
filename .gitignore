node_modules/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# A face you create while trying the skills here. Faces belong in the
# agent's own repo — never in this one.
/.agent-face/

# Skills installed into this checkout while testing the installer, and local
# agent settings. The repo's marketplace metadata, rules and safety skill stay.
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json
/.claude/*
!/.claude/rules/
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/repo-safety-scan/
/skills-lock.json

# The user's personal terms for the safety scan: never committed.
/.claude/skills/repo-safety-scan/personal-terms.local.json
